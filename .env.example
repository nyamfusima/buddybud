# Copy to .env and fill in. Never commit .env.

ENV=dev
SECRET_KEY=replace-with-output-of: python -c "import secrets;print(secrets.token_urlsafe(48))"

# Local dev uses SQLite automatically (backend/buddybud.db). For Postgres:
# DATABASE_URL=postgresql+psycopg://buddybud:buddybud@localhost:5432/buddybud

# --- AI model ---
# fake      = offline, deterministic, free (default; good for UI work and tests)
# anthropic = Claude via API (set ANTHROPIC_API_KEY)
# ollama    = local model (run `ollama pull qwen3:8b` first)
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_CLASSIFIER_MODEL=claude-haiku-5-5
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434

# --- URLs ---
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Email for invites + password resets (blank = links are printed in the API log) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BuddyBud <no-reply@yourdomain.com>

# --- Optional tracing with LangSmith (free Developer plan: 5k traces/month) ---
# Leave off when real agent data is involved unless your data owner has approved it.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=buddybud
